# ============================================================
# 《民中》 - 傲娇精子篇
# ============================================================

# ------------------------------------------------------------
# 角色定义（加入了傲娇的语气颜色）
# ------------------------------------------------------------
define me = Character("我", color="#FFFFFF")
define jz = Character("精子", color="#FF9EC4")  # 粉色代表傲娇
define teacher = Character("老师", color="#FFD27D")

# ------------------------------------------------------------
# 游戏变量
# ------------------------------------------------------------
default affection_jz = 0
default day = 1

# ============================================================
# 开始游戏
# ============================================================
label start:
    $ affection_jz = 0
    $ day = 1

    scene black
    show text "{size=48}民中{/size}" at truecenter
    pause 1.0
    hide text

    scene school_day
    "第一天。"
    "我站在民中的校门口。"
    me "……所以，这就是我要待上几年的地方吗？"
    "阳光从教学楼之间照下来。"
    "远处传来学生们的说话声和上课铃。"
    me "看来以后不会太无聊。"
    jump morning

# ============================================================
# 第一天早上
# ============================================================
label morning:
    scene classroom
    "教室里已经来了不少人。"
    "我随便找了个位置坐下。"
    "就在这时——"
    jz "喂。"
    me "嗯？"
    jz "这是你的座位吗？"
    me "不是我的还是你的吗？"
    jz "哼，谁稀罕。"
    jz "只是觉得你看起来像是第一天迷路的笨蛋。"
    me "……有这么明显吗？"
    jz "非常明显。"
    me "你呢？你也是新生？"
    jz "算是吧。"
    jz "我叫精子。"
    me "精子呀～？"
    jz "……你这是什么表情？"
    me "没什么，只是名字挺特别的。"
    jz "哼，闭嘴。"
    "她白了我一眼，然后在旁边的位置坐下。"
    jz "以后就是同学了，别给我添麻烦。"
    me "嗯，请多指教。"
    jz "……请多指教。"
    jump first_choice

# ============================================================
# 第一次选择（加好感度）
# ============================================================
label first_choice:
    menu:
        "主动搭话":
            $ affection_jz += 2
            me "精子呀～。"
            jz "干嘛？"
            me "你以前也在这里上学吗？"
            jz "没有。"
            jz "我也是第一次来。"
            me "这样啊。"
            jz "所以我们算是一样的。"
            me "那以后可以一起熟悉学校。"
            jz "……随便你啦。"
            "她嘴上这么说，但嘴角好像微微翘了一下。"
            jump lunch

        "安静看书":
            $ affection_jz += 1
            me "我先看看书吧。"
            jz "装什么好学生。"
            me "……"
            jz "……喏，这本给你。"
            "她递过来一本课本，眼神飘向别处。"
            me "谢谢。"
            jz "哼，别弄脏了。"
            jump lunch

# ============================================================
# 午休
# ============================================================
label lunch:
    scene classroom
    "上午的课程很快结束了。"
    "午休时间。"
    "我正准备一个人去食堂。"
    jz "喂。"
    me "怎么了？"
    jz "你要去吃饭吧？"
    me "嗯。"
    jz "……正好我也要去，一起。"
    me "好啊。"
    "她快步走到了我前面，好像怕我拒绝似的。"
    jump cafeteria

# ============================================================
# 食堂
# ============================================================
label cafeteria:
    scene cafeteria
    "食堂里非常热闹。"
    "两个人排了一会儿队。"
    jz "你吃什么？"
    me "还没想好。"
    jz "那边的套餐还不错。"
    me "你吃过？"
    jz "昨天刚来学校的时候吃过。"
    me "你昨天就来了？"
    jz "嗯。"
    jz "所以严格来说，我比你早一天熟悉这里。"
    me "那以后请多多指教了。"
    jz "哼，知道就好。"
    jump lunch_choice

# ============================================================
# 午饭选择
# ============================================================
label lunch_choice:
    menu:
        "听精子的建议":
            $ affection_jz += 2
            me "那我就听你的。"
            jz "算你识相。"
            "我们端着饭找了一个靠窗的位置。"
            jz "这里中午比较安静。"
            me "确实不错。"
            jz "那当然，我选的地方。"
            jump afternoon

        "自己决定":
            $ affection_jz += 1
            me "我还是自己看看吧。"
            jz "随你便。"
            "她似乎有点失落，但马上恢复了傲娇的表情。"
            jump afternoon

# ============================================================
# 下午
# ============================================================
label afternoon:
    scene classroom
    "下午的课程比上午更加无聊。"
    "我差点趴在桌子上睡着。"
    jz "喂，笨蛋。"
    me "嗯？"
    jz "你快睡着了。"
    me "我没有。"
    jz "你的眼睛都快闭上了。"
    me "……"
    jz "噗——"
    "她忍不住笑了出来。"
    me "你还不是一样。"
    jz "我可精神着呢。"
    teacher "最后一排的两位同学。"
    teacher "上课不要聊天。"
    me "……"
    jz "……"
    "我们同时安静了下来。"
    "她偷偷在桌子底下戳了我一下。"
    me "（干嘛？）"
    jz "（都怪你。）"
    jump after_school

# ============================================================
# 第一天放学
# ============================================================
label after_school:
    scene school_evening
    "放学铃响了。"
    "校园里的声音逐渐变得嘈杂起来。"
    jz "你回家吗？"
    me "嗯。"
    jz "那明天见。"
    me "明天见。"
    "她转身走了几步。"
    jz "喂。"
    me "怎么了？"
    jz "……明天别迟到，不然我可不管你。"
    me "知道了。"
    jz "……哼。"
    "她挥了挥手，快步离开了。"
    jump day_end

# ============================================================
# 第一天结束
# ============================================================
label day_end:
    scene black
    if affection_jz >= 5:
        "第一天。"
        "和精子相处的时间，比我想象中要多。"
        "她虽然嘴上不饶人，但其实人挺好的。"
    else:
        "第一天。"
        "一切都还只是刚刚开始。"
        "她好像有点难接近，但也许只是害羞。"
    "好感度：{color=#FF9EC4}[affection_jz]{/color}"
    pause 2
    show text "{size=36}第一天结束{/size}" at truecenter
    pause 2
    hide text
    jump day2_start

# ============================================================
# 第二天
# ============================================================
label day2_start:
    scene school_day
    "第二天。"
    "我走进教室，发现精子已经坐在座位上了。"
    jz "哟，居然没迟到。"
    me "那是当然。"
    jz "哼，我还以为你会睡过头。"
    me "你就这么不信任我？"
    jz "谁知道呢。"
    "她转过头去，假装整理书本。"
    "但我注意到，她旁边的座位被擦得很干净。"
    jump day2_choice

# ============================================================
# 第二天选择
# ============================================================
label day2_choice:
    menu:
        "坐到她旁边":
            $ affection_jz += 3
            me "那我就坐这儿了。"
            jz "……随便你，又不是我让你坐的。"
            "她往旁边挪了挪，给我腾出更多空间。"
            jz "别挤到我。"
            me "知道了知道了。"
            jump day2_afternoon

        "坐到后排":
            $ affection_jz += 0
            me "我还是坐后面吧。"
            jz "……哦。"
            "她低下头，声音明显小了很多。"
            jz "随你。"
            jump day2_afternoon

# ============================================================
# 第二天下午
# ============================================================
label day2_afternoon:
    scene classroom
    "下午的课，精子一直在偷偷看我这边。"
    "每次我转头，她就迅速把目光移开。"
    jz "……看什么看。"
    me "我什么都没说啊。"
    jz "你的眼神说了。"
    me "……"
    "下课后，她递过来一张纸条。"
    "上面写着：'放学后，天台见。'"
    me "天台？"
    jz "别问那么多，来就是了。"
    jump rooftop

# ============================================================
# 天台剧情
# ============================================================
label rooftop:
    scene school_evening
    "放学后，我来到天台。"
    "精子背对着我，站在栏杆旁边。"
    me "你找我？"
    jz "……嗯。"
    "她转过身来，脸有点红。"
    jz "那个……今天早上，谢谢你。"
    me "谢我什么？"
    jz "……没什么。"
    jz "只是觉得，有你在旁边，好像还不错。"
    me "？"
    jz "笨蛋！别多想！"
    jz "我只是……随便说说。"
    "她踢了一下栏杆，把头扭到一边。"
    if affection_jz >= 8:
        jz "……明天也要来啊。"
        me "嗯，一定。"
        jz "说好了，谁不来谁是小狗。"
    else:
        jz "……算了，当我没说。"
        me "我会来的。"
        jz "……随便你。"
    jump final_end

# ============================================================
# 结局
# ============================================================
label final_end:
    scene black
    show text "{size=40}未完待续{/size}" at truecenter
    pause 2
    show text "{size=28}感谢游玩 第一章{/size}" at truecenter
    pause 1
    hide text
    return